# BobHealth – environment variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env or share keys publicly.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Random long string – use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret

# ── Provider selection ────────────────────────────────────────────────────────
# Primary + fallback providers (comma-separated). "browser" = client-side.
STT_PROVIDER=watson
STT_FALLBACKS=elevenlabs,browser

TTS_PROVIDER=watson
TTS_FALLBACKS=elevenlabs,browser

TRANSLATE_PROVIDER=watsonx
TRANSLATE_FALLBACKS=mymemory

# ── Watson Speech-to-Text ─────────────────────────────────────────────────────
# https://cloud.ibm.com/catalog/services/speech-to-text
WATSON_STT_APIKEY=
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ── Watson Text-to-Speech ─────────────────────────────────────────────────────
# https://cloud.ibm.com/catalog/services/text-to-speech
WATSON_TTS_APIKEY=
WATSON_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# ── watsonx (translation / LLM) ──────────────────────────────────────────────
# https://dataplatform.cloud.ibm.com/wx/home
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── ElevenLabs ───────────────────────────────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# ── MyMemory (free translation fallback) ─────────────────────────────────────
# Optional – add your email to increase daily limit: https://mymemory.translated.net
MYMEMORY_EMAIL=
